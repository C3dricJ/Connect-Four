Function Main()
{
	//when program starts the following signals are defaulted
	PlayerTurn1 = 1;
	PlayerTurn2 = 0;
	
	ButtonState1 = 1;
	ButtonState2 = 1;
	ButtonState3 = 1;
	ButtonState4 = 1;
	ButtonState5 = 1;
	ButtonState6 = 1;
	ButtonState7 = 1; 
	
	Player1_W = "0";
	Player1_L = "0";
	Player1_T = "0";
	
	Player2_W = "0";
	Player2_L = "0";
	Player2_T = "0";	
}                                                                   
